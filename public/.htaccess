# ----------------------------------------------------------------------
# ITID France — Configuration Apache / LiteSpeed (.htaccess)
# Solution pour le routage SPA (Single Page Application) sur Hostinger
# ----------------------------------------------------------------------

# Activer la réécriture d'URL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer le HTTPS si non actif
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Ne pas réécrire index.html
  RewriteRule ^index\.html$ - [L]

  # Rediriger les requêtes API vers les scripts PHP natifs Hostinger
  RewriteRule ^api/contact/?$ api/contact/index.php [L,QSA]
  RewriteRule ^api/newsletter/subscribe/?$ api/newsletter/subscribe/index.php [L,QSA]
  RewriteRule ^api/auth/login/?$ api/auth/login/index.php [L,QSA]

  # Admin Messages
  RewriteRule ^api/admin/messages/export/csv/?$ api/admin/messages/index.php?export=csv [L,QSA]
  RewriteRule ^api/admin/messages/([0-9]+)/status/?$ api/admin/messages/index.php?id=$1&action=status [L,QSA]
  RewriteRule ^api/admin/messages/?$ api/admin/messages/index.php [L,QSA]

  # Admin Newsletter
  RewriteRule ^api/admin/newsletter/subscribers/export/csv/?$ api/admin/newsletter/subscribers/index.php?export=csv [L,QSA]
  RewriteRule ^api/admin/newsletter/subscribers/([0-9]+)/unsubscribe/?$ api/admin/newsletter/subscribers/index.php?id=$1&action=unsubscribe [L,QSA]
  RewriteRule ^api/admin/newsletter/subscribers/?$ api/admin/newsletter/subscribers/index.php [L,QSA]

  # Analytics Tracking Public
  RewriteRule ^api/analytics/track/?$ api/analytics/track/index.php [L,QSA]

  # Analytics Admin
  RewriteRule ^api/admin/analytics/export/csv/?$ api/admin/analytics/index.php?endpoint=export [L,QSA]
  RewriteRule ^api/admin/analytics/visitors/([0-9]+)/?$ api/admin/analytics/index.php?endpoint=visitor_detail&id=$1 [L,QSA]
  RewriteRule ^api/admin/analytics/([a-zA-Z0-9_\-]+)/?$ api/admin/analytics/index.php?endpoint=$1 [L,QSA]
  RewriteRule ^api/admin/analytics/?$ api/admin/analytics/index.php?endpoint=overview [L,QSA]

  # Si la requête correspond à un fichier réel (ex: .js, .css, .jpg, .mp4), le servir directement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pour toutes les autres routes (ex: /pathologies, /traitements, /admin, etc.), servir index.html
  RewriteRule . /index.html [L]
</IfModule>

# Types MIME additionnels (Modèles 3D GLB, Vidéos, Polices, Images modernes)
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/wasm .wasm
</IfModule>

# Caching & Performances
<IfModule mod_expires.c>
  ExpiresActive On

  # Fichiers statiques avec hash dans le nom (cache 1 an)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType model/gltf-binary "access plus 1 month"

  # index.html ne doit jamais être mis en cache agressivement
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Ne pas mettre index.html en cache pour que les mises à jour soient instantanées
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>
</IfModule>
