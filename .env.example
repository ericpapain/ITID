# Configuration du serveur Node.js
PORT=3001
NODE_ENV=development
APP_BASE_URL=https://itid-france.com

# Base de données MySQL Hostinger
# Renseigner ici les identifiants fournis dans le panneau hPanel Hostinger > Bases de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Serveur SMTP Hostinger (Emails)
# Renseigner la boîte email créée chez Hostinger (ex: contact@itid-france.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@itid-france.com
SMTP_PASSWORD=
CONTACT_EMAIL=contact@itid-france.com

# Configuration Newsletter
NEWSLETTER_FROM_EMAIL=contact@itid-france.com
NEWSLETTER_FROM_NAME=ITID France
NEWSLETTER_CRON_SECRET=remplacer_par_une_chaine_aleatoire_securisee

# Authentification Administrateur (CMS)
JWT_SECRET=remplacer_par_une_cle_jwt_aleatoire_tres_longue
ADMIN_DEFAULT_EMAIL=contact@itid-france.com
ADMIN_DEFAULT_PASSWORD=
